# Python bridge workspace. Invoked directly, or via the root justfile.

default: validate

lint:
    uv run ruff check src tests ../mcp-server

fmt:
    uv run ruff format src tests ../mcp-server

test:
    uv run pytest

# Opt-in sustained rate ladder. Saturates cores for ~45s at the default
# duration -- announce before running it on a shared box, and note that a
# non-zero saturated-tick count voids that row as a statement about the relay.
firehose seconds="10":
    FIREHOSE_BASELINE=1 FIREHOSE_SECONDS={{seconds}} uv run pytest tests/stress -v -s -k ladder

# Opt-in acceptance tests against a REAL device. Needs a powered reader in range
# of a reachable ESPHome proxy (ESPHOME_PROXY_HOST + BLE_MCP_DEVICE_MAC), and it
# takes the device for the duration -- announce before running it on a shared
# reader. Takes ~2 minutes: two of these have to outlast an idle timeout.
#
# It refuses to fall back to the stub transport. A hardware suite that passes
# against a fake is worse than no hardware suite.
hardware:
    BLE_MCP_HARDWARE=1 uv run pytest tests/hardware -v -s

# `validate` must mean the WHOLE gate from anywhere, so this delegates upward.
#
# It used to be `lint test` -- the Python half only. Run from this directory it
# passed 414 tests, exited 0, and silently skipped every TypeScript test and the
# TS lint. A narrow green is indistinguishable from a full one at the point of
# reading, and CLAUDE.md's claim that "just validate is the whole gate" was false
# for anyone standing here. Agents cd into bridge/ constantly.
#
# The root recipe calls `just lint` and `just test` in this file by name, never
# `validate`, so there is no recursion.
validate:
    cd .. && just validate

# The Python half on its own, when that is genuinely what you want.
validate-py: lint test
