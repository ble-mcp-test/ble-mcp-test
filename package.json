{
  "name": "ble-mcp-test",
  "version": "0.15.0",
  "description": "Web Bluetooth API mock for driving real BLE hardware from headless tests.",
  "keywords": [
    "ble",
    "bluetooth",
    "bluetooth-low-energy",
    "web-bluetooth",
    "web-bluetooth-mock",
    "mock",
    "testing",
    "e2e",
    "e2e-testing",
    "ble-testing",
    "playwright",
    "websocket",
    "claude",
    "ai",
    "coding-assistant"
  ],
  "author": "Mike Stankavich <mike@trakrf.id> (https://trakrf.id)",
  "license": "MIT",
  "homepage": "https://github.com/ble-mcp-test/ble-mcp-test",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ble-mcp-test/ble-mcp-test.git"
  },
  "bugs": {
    "url": "https://github.com/ble-mcp-test/ble-mcp-test/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "browser": "./dist/web-ble-mock.bundle.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/web-ble-mock.bundle.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run version:sync && tsc && pnpm run build:browser",
    "build:browser": "node scripts/build-browser-bundle.js",
    "version:sync": "node scripts/generate-version.js",
    "dev": "tsc --watch",
    "pretest": "node scripts/pre-test-cleanup.js",
    "test": "pnpm run pretest && vitest run tests/unit tests/conformance",
    "test:run": "pnpm run pretest && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run pretest && pnpm exec playwright test",
    "test:e2e:dev": "DEV_SERVER_URL=http://localhost:5173 pnpm run pretest && pnpm exec playwright test",
    "test:e2e:ci": "pnpm run pretest && pnpm exec playwright test",
    "test:unit": "pnpm run pretest && vitest run tests/unit",
    "test:conformance": "vitest run tests/conformance",
    "test:conformance:real": "pnpm exec playwright test -c playwright.conformance.config.ts",
    "test:all": "pnpm run pretest && vitest run && pnpm test:e2e",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run pretest && pnpm exec playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "dotenv": "^17.2.1",
    "esbuild": "^0.25.8",
    "eslint": "^8.56.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.1",
    "supertest": "^6.3.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "ws": "^8.16.0"
  }
}
